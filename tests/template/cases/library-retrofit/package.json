{
  "name": "demo-retrofit-workspace",
  "private": true,
  "description": "A demo Vue library moved onto the template, with a playground",
  "license": "MIT",
  "author": "Whatsaaaa",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:browser": "run-s build test:browser:run",
    "test:browser:run": "playwright test",
    "type-check": "tsc && pnpm -r type-check",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:css": "stylelint \"**/*.{css,vue}\" --fix --allow-empty-input",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@whatsaaaa/design-system": "^0.8.2",
    "@whatsaaaa/eslint-config": "^1.0.0",
    "@whatsaaaa/format-config": "^1.0.0",
    "@whatsaaaa/oxlint-config": "^1.0.0",
    "@whatsaaaa/tsconfig": "^1.0.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
