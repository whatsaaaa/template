# npm's trusted publisher names this file: keep its name.
name: Release

on:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}

jobs:
  release:
    uses: whatsaaaa/template/.github/workflows/changesets-release.yml@v1
    permissions:
      contents: write # Version Packages pull request, git tags and GitHub releases
      pull-requests: write # Version Packages pull request
      id-token: write # npm OIDC
